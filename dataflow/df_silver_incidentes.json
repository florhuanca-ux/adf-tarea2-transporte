{
	"name": "df_silver_incidentes",
	"properties": {
		"folder": {
			"name": "silver"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "dw_bronze_incidentes_sql",
						"type": "DatasetReference"
					},
					"name": "source1"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "dw_silver_incidentes_sql",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "derivedColumn1"
				},
				{
					"name": "derivedColumn2"
				},
				{
					"name": "aggregate1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          AnioFuente as string,",
				"          IncidenteId as string,",
				"          TipoIncidente as string,",
				"          Severidad as string,",
				"          FechaHoraInicio as string,",
				"          FechaHoraFin as string,",
				"          FechaHoraRegistro as string,",
				"          VehiculoId as string,",
				"          Descripcion as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> source1",
				"source1 derive(VehiculoId = iif(isNull(VehiculoId) || trim(VehiculoId) == '', toString(null()),",
				"    'V-' + lpad(regexReplace(VehiculoId, '[^0-9]', ''), 3, '0')),",
				"          FechaHoraInicio = coalesce(",
				"  toTimestamp(trim(FechaHoraInicio), 'yyyy-MM-dd HH:mm:ss'),",
				"  toTimestamp(trim(FechaHoraInicio), 'dd/MM/yyyy'),",
				"  toTimestamp(trim(FechaHoraInicio), 'yyyy-MM-dd'),",
				"  iif(regexMatch(trim(FechaHoraInicio), '^[0-9]{5}$'),",
				"      toTimestamp(addDays(toDate('1899-12-30'), toInteger(trim(FechaHoraInicio)))))",
				"),",
				"          FechaHoraFin = coalesce(",
				"  toTimestamp(trim(FechaHoraFin), 'yyyy-MM-dd HH:mm:ss'),",
				"  toTimestamp(trim(FechaHoraFin), 'dd/MM/yyyy'),",
				"  toTimestamp(trim(FechaHoraFin), 'yyyy-MM-dd'),",
				"  iif(regexMatch(trim(FechaHoraFin), '^[0-9]{5}$'),",
				"      toTimestamp(addDays(toDate('1899-12-30'), toInteger(trim(FechaHoraFin)))))",
				"),",
				"          FechaHoraRegistro = toTimestamp(",
				"    iif(locate('-', FechaHoraRegistro) > 0, ",
				"        right(FechaHoraRegistro, 2) + '/' + substring(FechaHoraRegistro, 6, 2) + '/' + left(FechaHoraRegistro, 4), ",
				"        FechaHoraRegistro) + ' 00:00', ",
				"    'dd/MM/yyyy HH:mm'",
				")) ~> derivedColumn1",
				"derivedColumn1 derive(TipoIncidente = upper(trim(TipoIncidente)),",
				"          Severidad = upper(trim(Severidad)),",
				"          Descripcion = trim(Descripcion)) ~> derivedColumn2",
				"derivedColumn2 aggregate(groupBy(IncidenteId),",
				"     TipoIncidente = first(TipoIncidente),",
				"          Severidad = first(Severidad),",
				"          FechaHoraInicio = first(FechaHoraInicio),",
				"          FechaHoraFin = first(FechaHoraFin),",
				"          FechaHoraRegistro = first(FechaHoraRegistro),",
				"          VehiculoId = first(VehiculoId),",
				"          Descripcion = first(Descripcion)) ~> aggregate1",
				"aggregate1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          IncidenteId as string,",
				"          TipoIncidente as string,",
				"          Severidad as string,",
				"          FechaHoraInicio as timestamp,",
				"          FechaHoraFin as timestamp,",
				"          FechaHoraRegistro as timestamp,",
				"          VehiculoId as string,",
				"          Descripcion as string",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          IncidenteId,",
				"          TipoIncidente,",
				"          Severidad,",
				"          FechaHoraInicio,",
				"          FechaHoraFin,",
				"          FechaHoraRegistro,",
				"          VehiculoId,",
				"          Descripcion",
				"     )) ~> sink1"
			]
		}
	}
}