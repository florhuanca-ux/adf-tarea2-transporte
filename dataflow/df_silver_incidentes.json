{
	"name": "df_silver_incidentes",
	"properties": {
		"folder": {
			"name": "silver"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "dw_bronze_incidentes_sql",
						"type": "DatasetReference"
					},
					"name": "source1"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "dw_silver_incidentes_sql",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "derivedColumn1"
				},
				{
					"name": "derivedColumn2"
				}
			],
			"scriptLines": [
				"source(output(",
				"          AnioFuente as string,",
				"          IncidenteId as string,",
				"          TipoIncidente as string,",
				"          Severidad as string,",
				"          FechaHoraInicio as string,",
				"          FechaHoraFin as string,",
				"          FechaHoraRegistro as string,",
				"          VehiculoId as string,",
				"          Descripcion as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> source1",
				"source1 derive(VehiculoId = iif(isNull(VehiculoId) || trim(VehiculoId) == '' || trim(VehiculoId) == 'NaN', ",
				"    toString(null()), ",
				"    iif(instr(VehiculoId, 'V-') > 0, VehiculoId, 'V-' + lpad(trim(replace(VehiculoId, 'V', '')), 3, '0'))",
				"),",
				"          FechaHoraInicio = toTimestamp(",
				"    iif(locate('-', FechaHoraInicio) > 0, ",
				"        right(FechaHoraInicio, 2) + '/' + substring(FechaHoraInicio, 6, 2) + '/' + left(FechaHoraInicio, 4), ",
				"        FechaHoraInicio) + ' 00:00', ",
				"    'dd/MM/yyyy HH:mm'",
				"),",
				"          FechaHoraFin = toTimestamp(",
				"    iif(locate('-', FechaHoraFin) > 0, ",
				"        right(FechaHoraFin, 2) + '/' + substring(FechaHoraFin, 6, 2) + '/' + left(FechaHoraFin, 4), ",
				"        FechaHoraFin) + ' 00:00', ",
				"    'dd/MM/yyyy HH:mm'",
				"),",
				"          FechaHoraRegistro = toTimestamp(",
				"    iif(locate('-', FechaHoraRegistro) > 0, ",
				"        right(FechaHoraRegistro, 2) + '/' + substring(FechaHoraRegistro, 6, 2) + '/' + left(FechaHoraRegistro, 4), ",
				"        FechaHoraRegistro) + ' 00:00', ",
				"    'dd/MM/yyyy HH:mm'",
				")) ~> derivedColumn1",
				"derivedColumn1 derive(TipoIncidente = upper(trim(TipoIncidente)),",
				"          Severidad = upper(trim(Severidad)),",
				"          Descripcion = trim(Descripcion)) ~> derivedColumn2",
				"derivedColumn2 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          IncidenteId as string,",
				"          TipoIncidente as string,",
				"          Severidad as string,",
				"          FechaHoraInicio as timestamp,",
				"          FechaHoraFin as timestamp,",
				"          FechaHoraRegistro as timestamp,",
				"          VehiculoId as string,",
				"          Descripcion as string",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          IncidenteId,",
				"          TipoIncidente,",
				"          Severidad,",
				"          FechaHoraInicio,",
				"          FechaHoraFin,",
				"          FechaHoraRegistro,",
				"          VehiculoId,",
				"          Descripcion",
				"     )) ~> sink1"
			]
		}
	}
}