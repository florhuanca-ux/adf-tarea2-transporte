{
	"name": "df_silver_rutas",
	"properties": {
		"folder": {
			"name": "silver"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "dw_bronze_rutas_sql",
						"type": "DatasetReference"
					},
					"name": "source1"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "dw_silver_rutas_sql",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "derivedColumn1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          AnioFuente as string,",
				"          RutaHistoricaId as string,",
				"          CodigoRuta as string,",
				"          NombreRuta as string,",
				"          Origen as string,",
				"          Destino as string,",
				"          VigenciaDesde as string,",
				"          VigenciaHasta as string,",
				"          Estado as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> source1",
				"source1 derive(NombreRuta = trim(NombreRuta),",
				"          Estado = upper(trim(Estado)),",
				"          Origen = initCap(trim(Origen)),",
				"          Destino = initCap(trim(Destino)),",
				"          CodigoRuta = iif(instr(CodigoRuta, 'Ruta') > 0,      'R-' + lpad(trim(replace(CodigoRuta, 'Ruta', '')), 2, '0'),      iif(instr(CodigoRuta, 'R-') > 0, CodigoRuta, 'R-' + lpad(trim(CodigoRuta), 2, '0')) ),",
				"          VigenciaDesde = coalesce(  toDate(VigenciaDesde, 'dd/MM/yyyy'),  toDate(left(VigenciaDesde, 10), 'yyyy-MM-dd'),  addDays(toDate('1899-12-30'), toInteger(VigenciaDesde))),",
				"          VigenciaHasta = coalesce(  toDate(VigenciaHasta, 'dd/MM/yyyy'),  toDate(left(VigenciaHasta, 10), 'yyyy-MM-dd'),  addDays(toDate('1899-12-30'), toInteger(VigenciaHasta))),",
				"          RutaHistoricaId = iif(isNull(RutaHistoricaId),     'RH-' + lpad(regexReplace(CodigoRuta, '[^0-9]', ''), 2, '0'),     trim(RutaHistoricaId))) ~> derivedColumn1",
				"derivedColumn1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          RutaHistoricaId as string,",
				"          CodigoRuta as string,",
				"          NombreRuta as string,",
				"          Origen as string,",
				"          Destino as string,",
				"          VigenciaDesde as date,",
				"          VigenciaHasta as date,",
				"          Estado as string",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          RutaHistoricaId,",
				"          CodigoRuta,",
				"          NombreRuta,",
				"          Origen,",
				"          Destino,",
				"          VigenciaDesde,",
				"          VigenciaHasta,",
				"          Estado",
				"     )) ~> sink1"
			]
		}
	}
}