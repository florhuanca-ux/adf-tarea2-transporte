{
	"name": "df_silver_viajes",
	"properties": {
		"folder": {
			"name": "silver"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "dw_bronze_viajes_sql",
						"type": "DatasetReference"
					},
					"name": "source1"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "dw_silver_viajes_sql",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "derivedColumn1"
				},
				{
					"name": "derivedColumn2"
				},
				{
					"name": "aggregate1"
				},
				{
					"name": "filter1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          AnioFuente as string,",
				"          ViajeId as string,",
				"          RutaHistoricaId as string,",
				"          VehiculoId as string,",
				"          FechaServicio as string,",
				"          HoraProgramada as string,",
				"          HoraSalida as string,",
				"          HoraLlegada as string,",
				"          ValidacionesTarjeta as string,",
				"          KmRecorridos as string,",
				"          EstadoViaje as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> source1",
				"source1 derive(RutaHistoricaId = iif(isNull(RutaHistoricaId) || trim(RutaHistoricaId) == '', toString(null()),",
				"    iif(left(trim(RutaHistoricaId),3) == 'RH-', trim(RutaHistoricaId),",
				"        'RH-' + lpad(regexReplace(RutaHistoricaId,'[^0-9]',''),2,'0'))),",
				"          VehiculoId = iif(isNull(VehiculoId) || trim(VehiculoId) == '', toString(null()),",
				"    'V-' + lpad(regexReplace(VehiculoId, '[^0-9]', ''), 3, '0')),",
				"          FechaServicio = toDate(",
				"    iif(locate('-', FechaServicio) > 0, ",
				"        right(FechaServicio, 2) + '/' + substring(FechaServicio, 6, 2) + '/' + left(FechaServicio, 4), ",
				"        FechaServicio",
				"    ), ",
				"    'dd/MM/yyyy'",
				")) ~> derivedColumn1",
				"derivedColumn1 derive(KmRecorridos = toDecimal(replace(KmRecorridos, ',', '.'), 8, 1),",
				"          EstadoViaje = upper(trim(EstadoViaje)),",
				"          ValidacionesTarjeta = coalesce(toInteger(ValidacionesTarjeta), 0),",
				"          HoraProgramada = toTimestamp('2020-01-01 ' + trim(HoraProgramada), 'yyyy-MM-dd HH:mm'),",
				"          HoraSalida = toTimestamp('2020-01-01 ' + trim(HoraSalida), 'yyyy-MM-dd HH:mm'),",
				"          HoraLlegada = toTimestamp('2020-01-01 ' + trim(HoraLlegada), 'yyyy-MM-dd HH:mm')) ~> derivedColumn2",
				"filter1 aggregate(groupBy(ViajeId),",
				"     RutaHistoricaId = first(RutaHistoricaId),",
				"          VehiculoId = first(VehiculoId),",
				"          FechaServicio = first(FechaServicio),",
				"          HoraProgramada = first(HoraProgramada),",
				"          HoraSalida = first(HoraSalida),",
				"          HoraLlegada = first(HoraLlegada),",
				"          ValidacionesTarjeta = first(ValidacionesTarjeta),",
				"          KmRecorridos = first(KmRecorridos),",
				"          EstadoViaje = first(EstadoViaje)) ~> aggregate1",
				"derivedColumn2 filter(!isNull(RutaHistoricaId)) ~> filter1",
				"aggregate1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          ViajeId as string,",
				"          RutaHistoricaId as string,",
				"          VehiculoId as string,",
				"          FechaServicio as date,",
				"          HoraProgramada as timestamp,",
				"          HoraSalida as timestamp,",
				"          HoraLlegada as timestamp,",
				"          ValidacionesTarjeta as integer,",
				"          KmRecorridos as decimal(8,1),",
				"          EstadoViaje as string",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          ViajeId,",
				"          RutaHistoricaId,",
				"          VehiculoId,",
				"          FechaServicio,",
				"          HoraProgramada,",
				"          HoraSalida,",
				"          HoraLlegada,",
				"          ValidacionesTarjeta,",
				"          KmRecorridos,",
				"          EstadoViaje",
				"     )) ~> sink1"
			]
		}
	}
}