{
	"name": "df_silver_demanda_paradas",
	"properties": {
		"folder": {
			"name": "silver"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "dw_bronze_demanda_paradas_sql",
						"type": "DatasetReference"
					},
					"name": "source1"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "dw_silver_demanda_paradas_sql",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "derivedColumn1"
				},
				{
					"name": "derivedColumn2"
				}
			],
			"scriptLines": [
				"source(output(",
				"          AnioFuente as string,",
				"          DemandaId as string,",
				"          FechaServicio as string,",
				"          RutaHistoricaId as string,",
				"          ParadaHistoricaId as string,",
				"          Franja as string,",
				"          ValidacionesTarjeta as string,",
				"          Descensos as string,",
				"          DemandaNoAtendida as string,",
				"          Metodo as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> source1",
				"source1 derive(DemandaId = sha2(256, toString(FechaServicio) + '-' + toString(RutaHistoricaId) + '-' + toString(ParadaHistoricaId) + '-' + toString(Franja)),",
				"          FechaServicio = coalesce(",
				"  toDate(trim(FechaServicio), 'dd/MM/yyyy'),",
				"  toDate(left(trim(FechaServicio), 10), 'yyyy-MM-dd'),",
				"  addDays(toDate('1899-12-30'), toInteger(trim(FechaServicio)))",
				"),",
				"          RutaHistoricaId = iif(instr(RutaHistoricaId, 'R-') > 0, trim(RutaHistoricaId), 'R-' + lpad(trim(RutaHistoricaId), 2, '0'))) ~> derivedColumn1",
				"derivedColumn1 derive(ParadaHistoricaId = trim(ParadaHistoricaId),",
				"          Franja = trim(Franja),",
				"          Descensos = coalesce(toInteger(Descensos), 0),",
				"          ValidacionesTarjeta = coalesce(toInteger(ValidacionesTarjeta), 0),",
				"          DemandaNoAtendida = coalesce(toInteger(DemandaNoAtendida), 0)) ~> derivedColumn2",
				"derivedColumn2 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          DemandaId as string,",
				"          FechaServicio as date,",
				"          RutaHistoricaId as string,",
				"          ParadaHistoricaId as string,",
				"          Franja as string,",
				"          ValidacionesTarjeta as integer,",
				"          Descensos as integer,",
				"          DemandaNoAtendida as integer,",
				"          Metodo as string",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          DemandaId,",
				"          FechaServicio,",
				"          RutaHistoricaId,",
				"          ParadaHistoricaId,",
				"          Franja,",
				"          ValidacionesTarjeta,",
				"          Descensos,",
				"          DemandaNoAtendida,",
				"          Metodo",
				"     )) ~> sink1"
			]
		}
	}
}